+            decoration: InputDecoration(
+              isDense: true,
+              hintText: S.current.sticker_marketSearchHint,
+              hintStyle: TextStyle(
+                color: theme.colorScheme.onSurfaceVariant,
+                fontSize: 14,
+              ),
+              prefixIcon: const Icon(Symbols.search_rounded, size: 18),
